      "foreignKeys": {},
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "conversion_diagnostics_source": {
          "name": "conversion_diagnostics_source",
          "value": "(\"conversion_diagnostics\".\"source\" = 'preset_client' AND \"conversion_diagnostics\".\"mode\" = 'preset') OR (\"conversion_diagnostics\".\"source\" = 'ai_server' AND \"conversion_diagnostics\".\"mode\" = 'ai')"
        },
        "conversion_diagnostics_language": {
          "name": "conversion_diagnostics_language",
          "value": "\"conversion_diagnostics\".\"language\" IN ('ja','en','unknown')"
        },
        "conversion_diagnostics_style": {
          "name": "conversion_diagnostics_style",
          "value": "\"conversion_diagnostics\".\"style\" IN ('business','academic','casual','unknown')"
        },
        "conversion_diagnostics_state": {
          "name": "conversion_diagnostics_state",
          "value": "\"conversion_diagnostics\".\"status\" IN ('ok','failed')"
        },
        "conversion_diagnostics_words": {
          "name": "conversion_diagnostics_words",
          "value": "\"conversion_diagnostics\".\"total_words\" BETWEEN 0 AND 3000 AND \"conversion_diagnostics\".\"changed_words\" BETWEEN 0 AND \"conversion_diagnostics\".\"total_words\""
        },
        "conversion_diagnostics_candidates": {
          "name": "conversion_diagnostics_candidates",
          "value": "\"conversion_diagnostics\".\"proposed\" BETWEEN 0 AND 512 AND \"conversion_diagnostics\".\"applied\" BETWEEN 0 AND \"conversion_diagnostics\".\"proposed\""
        },
        "conversion_diagnostics_times": {
          "name": "conversion_diagnostics_times",
          "value": "\"conversion_diagnostics\".\"elapsed_ms\" BETWEEN 0 AND 180000 AND \"conversion_diagnostics\".\"provider_ms\" BETWEEN 0 AND \"conversion_diagnostics\".\"elapsed_ms\" AND \"conversion_diagnostics\".\"validation_ms\" BETWEEN 0 AND \"conversion_diagnostics\".\"elapsed_ms\""
        }
      }
