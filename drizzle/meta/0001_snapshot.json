      "checkConstraints": {
        "error_reports_id_lengths": {
          "name": "error_reports_id_lengths",
          "value": "length(\"error_reports\".\"report_id\") = 36 AND (length(\"error_reports\".\"request_id\") = 36 OR \"error_reports\".\"request_id\" = 'unavailable')"
        },
        "error_reports_code_length": {
          "name": "error_reports_code_length",
          "value": "length(\"error_reports\".\"code\") BETWEEN 1 AND 64"
        },
        "error_reports_stage_length": {
          "name": "error_reports_stage_length",
          "value": "length(\"error_reports\".\"stage\") BETWEEN 1 AND 32"
        },
        "error_reports_version_length": {
          "name": "error_reports_version_length",
          "value": "length(\"error_reports\".\"version\") BETWEEN 1 AND 32"
        },
        "error_reports_date_lengths": {
          "name": "error_reports_date_lengths",
          "value": "length(\"error_reports\".\"timestamp\") = 24 AND length(\"error_reports\".\"server_received_at\") = 24"
        },
        "error_reports_http_status_bounds": {
          "name": "error_reports_http_status_bounds",
          "value": "\"error_reports\".\"http_status\" = 0 OR \"error_reports\".\"http_status\" BETWEEN 100 AND 599"
        },
        "error_reports_upstream_status_bounds": {
          "name": "error_reports_upstream_status_bounds",
          "value": "\"error_reports\".\"upstream_status\" IS NULL OR \"error_reports\".\"upstream_status\" BETWEEN 100 AND 599"
